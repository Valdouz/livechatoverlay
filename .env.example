# ─────────────────────────────────────────────────────────────────────────────
#  LiveChat — configuration d'installation
#
#  Copiez ce fichier en .env et remplissez-le. Une seule fois : tout le reste
#  (quota disque, salon surveillé, rétention, admins…) se règle depuis le
#  panneau admin de l'application, sans redémarrer.
#
#  Pas à pas détaillé : INSTALL.md
# ─────────────────────────────────────────────────────────────────────────────

# Onglet "Bot" du portail Discord > Reset Token.
# Pensez à activer "Message Content Intent" juste en dessous.
DISCORD_TOKEN=

# Onglet "OAuth2" du portail Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Identifiant de votre serveur Discord.
# Discord > Paramètres > Avancés > Mode développeur, puis clic droit sur le
# serveur > Copier l'identifiant.
DISCORD_GUILD_ID=

# Votre identifiant Discord personnel : vous serez le propriétaire de l'instance.
# C'est vous qui nommerez les administrateurs, depuis l'application.
OWNER_ID=

# L'adresse publique du serveur, telle que les autres y accèdent.
# Doit correspondre EXACTEMENT à la redirection déclarée dans le portail
# Discord, qui doit valoir : <PUBLIC_URL>/auth/callback
PUBLIC_URL=https://livechat.exemple.fr

# Où sont rangés les médias et les réglages. Laissez tel quel avec Docker.
DATA_DIR=/data

# Adresse et port d'écoute. Derrière un reverse proxy, ne changez rien.
HOST=0.0.0.0
PORT=3000

# Nom de domaine servi par Caddy — doit correspondre a PUBLIC_URL.
DOMAIN=livechat.exemple.fr
